{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "comfyui-mcp": {
      "type": "local",
      "command": ["npx", "-y", "comfyui-mcp"],
      "enabled": true,
      "environment": {
        "CIVITAI_API_TOKEN": ""
      }
    },
    "comfyui-mcp-server": {
      "type": "remote",
      "url": "http://127.0.0.1:9000/mcp",
      "enabled": true
    }
  }
}